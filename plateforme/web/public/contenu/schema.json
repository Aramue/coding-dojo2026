        "title": "Indices",
        "type": "array"
      },
      "tests": {
        "items": {
          "discriminator": {
            "mapping": {
              "contient": "#/$defs/TestMotif",
              "interdit": "#/$defs/TestMotif",
              "qcm": "#/$defs/TestQcm",
              "sortie": "#/$defs/TestSortie",
              "variable": "#/$defs/TestVariable"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TestSortie"
            },
            {
              "$ref": "#/$defs/TestVariable"
            },
            {
              "$ref": "#/$defs/TestQcm"
            },
            {
              "$ref": "#/$defs/TestMotif"
            }
          ]
        },
        "minItems": 1,
        "title": "Tests",
        "type": "array"
      },
      "solution": {
        "title": "Solution",
        "type": "string"
      },
      "expert": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expert"
      }
