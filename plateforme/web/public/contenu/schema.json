            "type": "string"
          },
          "legende": {
            "minLength": 1,
            "title": "Legende",
            "type": "string"
          },
          "python": {
            "minLength": 1,
            "title": "Python",
            "type": "string"
          },
          "executable": {
            "default": false,
            "title": "Executable",
            "type": "boolean"
          },
          "entrees": {
            "items": {
              "type": "string"
            },
            "title": "Entrees",
            "type": "array"
          }
        },
        "required": [
          "type",
          "legende",
          "python"
        ],
        "title": "BlocCode",
        "type": "object"
      },
      "BlocParagraphe": {
        "properties": {
          "type": {
            "const": "paragraphe",
            "title": "Type",
            "type": "string"
          },
          "texte": {
            "minLength": 1,
            "title": "Texte",
            "type": "string"
          }
        },
        "required": [
          "type",
          "texte"
        ],
        "title": "BlocParagraphe",
        "type": "object"
      }
    },
    "description": "Une lecon : ce que l'eleve lit avant d'attaquer les exercices d'une notion.",
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "notion": {
        "title": "Notion",
        "type": "string"
      },
      "ordre": {
        "title": "Ordre",
        "type": "integer"
      },
      "titre": {
        "minLength": 1,
        "title": "Titre",
        "type": "string"
      },
      "duree_min": {
        "maximum": 30,
        "minimum": 1,
        "title": "Duree Min",
        "type": "integer"
      },
      "blocs": {
        "items": {
          "discriminator": {
            "mapping": {
              "attention": "#/$defs/BlocAttention",
              "code": "#/$defs/BlocCode",
              "paragraphe": "#/$defs/BlocParagraphe"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BlocParagraphe"
            },
            {
              "$ref": "#/$defs/BlocAttention"
            },
            {
              "$ref": "#/$defs/BlocCode"
            }
          ]
        },
        "minItems": 1,
        "title": "Blocs",
        "type": "array"
      }
    },
    "required": [
      "id",
      "notion",
      "ordre",
      "titre",
      "duree_min",
      "blocs"
    ],
    "title": "Lecon",
    "type": "object"
