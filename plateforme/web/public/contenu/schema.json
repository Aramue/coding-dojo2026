    "required": [
      "id",
      "concept",
      "notion",
      "seance",
      "niveau",
      "type",
      "titre",
      "obligatoire",
      "enonce",
      "tests",
      "solution"
    ],
    "title": "Exercice",
    "type": "object"
  },
  "lecon": {
    "$defs": {
