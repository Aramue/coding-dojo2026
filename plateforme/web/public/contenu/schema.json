        "title": "Type",
        "type": "string"
      },
      "titre": {
        "title": "Titre",
        "type": "string"
      },
      "obligatoire": {
        "title": "Obligatoire",
        "type": "boolean"
      },
      "enonce": {
        "title": "Enonce",
        "type": "string"
      },
