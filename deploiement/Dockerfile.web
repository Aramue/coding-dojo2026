FROM python:3.12-slim AS contenu
WORKDIR /build
COPY plateforme/outils ./outils
COPY plateforme/contenu ./contenu
RUN pip install --no-cache-dir -r outils/requirements.txt \
 && cd outils && python construire_contenu.py ../contenu /build/public-contenu

# Etage de DEVELOPPEMENT : node et les dependances, rien d'autre. Les sources
# arrivent par un montage depuis l'hote, et Vite les surveille.
#
# ATTENTION : cet etage doit rester AVANT le dernier. `docker build` sans
# `--target` prend le dernier etage du fichier — le mettre en fin donnerait une
# image de developpement a la production, sans que rien ne le signale.
FROM node:22-slim AS developpement
WORKDIR /app
RUN npm install -g pnpm@11.25.0
COPY plateforme/web/package.json plateforme/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]

FROM node:22-slim AS construction
WORKDIR /build
# corepack plante ici, meme epingle : son shim relit devEngines.packageManager
# dans package.json a chaque invocation de pnpm, et ce champ porte un intervalle
# semver (^11.8.0) la ou corepack exige une version exacte. On installe donc
# pnpm directement via npm, hors du chemin de validation de corepack.
RUN npm install -g pnpm@11.25.0
COPY plateforme/web/package.json plateforme/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY plateforme/web .
COPY --from=contenu /build/public-contenu ./public/contenu
RUN pnpm build

FROM caddy:2-alpine
COPY --from=construction /build/dist /srv
COPY deploiement/Caddyfile /etc/caddy/Caddyfile
