# Caddy ne fait PAS de TLS, et n'ecoute qu'en clair. Il ne connait meme pas le
# nom du site.
#
# Sur la VM, nginx tient deja les ports 80 et 443 pour d'autres sites, avec ses
# certificats certbot : c'est lui qui termine le TLS et qui relaie vers ce
# conteneur, publie sur 127.0.0.1 seulement. En developpement on ouvre
# http://localhost, ou il n'y a rien a certifier. Voir ADR-017 et
# « Deploiement UNIGE » dans le coffre.
#
# Ce que cela a supprime : le bloc a deux schemas qu'il fallait declarer pour
# echapper a la redirection HTTPS automatique de Caddy, le volume de ses
# certificats, et la variable DOJO_DOMAINE.
:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Pyodide et les polices : immuables, mis en cache un an.
		@immuables path /pyodide/* /polices/* /assets/*
		header @immuables Cache-Control "public, max-age=31536000, immutable"

		# Le contenu, lui, change sans changer de nom de fichier : il est
		# reconstruit a chaque `docker compose build`, mais /contenu/exercices.json
		# garde son chemin. Sans revalidation, une correction faite en seance
		# n'atteindrait pas les navigateurs qui ont deja charge la page — et
		# personne ne comprendrait pourquoi.
		@contenu path /contenu/*
		header @contenu Cache-Control "no-cache"
		# WebAssembly doit etre servi avec le bon type MIME, sinon Pyodide echoue.
		@wasm path *.wasm
		header @wasm Content-Type "application/wasm"
		try_files {path} /index.html
		file_server
	}
}
