# Copier en .env avant le premier demarrage. Le .env reel n'est PAS dans le
# depot : il porte les secrets de l'instance.
#
#   cp .env.example .env
#   # puis remplacer les deux valeurs :
#   #   openssl rand -hex 24   -> DOJO_SECRET
#   #   openssl rand -hex 8    -> DOJO_CODE_PROF

# Signe les jetons de session des eleves. A defaut, l'API tire un secret
# aleatoire au demarrage : les sessions ne survivent pas a un redemarrage.
DOJO_SECRET=a-remplacer

# Ouvre le tableau de bord professeur, sur /prof. A garder pour toi.
DOJO_CODE_PROF=a-remplacer

# Nom d'hote servi par Caddy. localhost en developpement.
DOJO_DOMAINE=localhost
